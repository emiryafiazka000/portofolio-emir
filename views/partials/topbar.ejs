<header class="glass topbar reveal" id="topbar">
  <!-- Traffic lights ala macOS -->
  <div class="tl-dots" aria-hidden="true">
    <span class="dot dot-red"></span>
    <span class="dot dot-yellow"></span>
    <span class="dot dot-green"></span>
  </div>

  <!-- Title -->
  <div class="topbar-title">
    <span class="brand-mark" aria-hidden="true">
      <%- SVG('code', 'w-3 h-3') %>
    </span>
    <h1 class="font-mono tracking-[0.22em] text-[10px] sm:text-[11px] uppercase text-white/75 whitespace-nowrap">
      <%= portfolio.site.title %>
    </h1>
  </div>

  <!-- Navigasi section — liquid radio style -->
  <nav class="liquid-radio" id="liquidNav" aria-label="Navigasi halaman" data-active="about">
    <div class="liquid-radio-bg" aria-hidden="true"></div>
    <div class="liquid-radio-glass" aria-hidden="true" style="filter: url('#radio-glass')"></div>
    <div class="liquid-radio-indicator" id="navIndicator"></div>
    <a href="#about" class="liquid-radio-item active" data-section="about">About</a>
    <a href="#projects" class="liquid-radio-item" data-section="projects">Projects</a>
    <a href="#contact" class="liquid-radio-item" data-section="contact">Contact</a>
  </nav>

  <!-- Action icons -->
  <div class="topbar-actions">
    <button class="icon-btn" id="chatBtn" title="Chat" aria-label="Scroll ke kontak">
      <%- SVG('chat', 'w-4 h-4') %>
    </button>

    <div class="socials-wrap">
      <button class="icon-btn" id="socialsBtn" title="Socials" aria-label="Buka daftar sosial media">
        <%- SVG('users', 'w-4 h-4') %>
      </button>
      <div class="socials-menu glass" id="socialsMenu" hidden>
        <p class="socials-menu-label font-mono text-[10px] uppercase tracking-widest text-white/40 px-4 pt-3 pb-1">Socials</p>
        <% portfolio.socials.forEach(s => { %>
          <a class="socials-menu-item" href="<%= s.url %>" target="_blank" rel="noopener">
            <span class="menu-icon"><%- SVG(s.icon, 'w-3.5 h-3.5') %></span>
            <span class="text-[13px] text-white/80"><%= s.name %></span>
            <%- SVG('arrow', 'w-3 h-3 menu-arrow') %>
          </a>
        <% }) %>
      </div>
    </div>

    <a class="icon-btn" href="<%= (portfolio.socials.find(s => s.icon === 'github') || {}).url || '#' %>" target="_blank" rel="noopener" title="GitHub" aria-label="Buka GitHub">
      <%- SVG('github', 'w-4 h-4') %>
    </a>
  </div>
</header>
